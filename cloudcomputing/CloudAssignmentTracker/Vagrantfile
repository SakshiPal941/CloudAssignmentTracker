# -*- mode: ruby -*-
# vi: set ft=ruby :


Vagrant.configure("2") do |config|

  config.vm.box = "ubuntu/jammy64"
  # vagrant-vbguest can crash trying to match guest additions against newer VirtualBox host versions; skip it.
  config.vbguest.auto_update = false if Vagrant.has_plugin?("vagrant-vbguest")
  # The ubuntu/jammy64 box occasionally hits severe (but harmless) kernel "soft lockup"
  # watchdog storms during boot on some VirtualBox/host combinations, which can push
  # SSH readiness past Vagrant's default 300s boot_timeout. Give it more headroom.
  config.vm.boot_timeout = 600

  # The box's guest additions userland tools are missing, so Vagrant's own /vagrant
  # auto-mount silently gets skipped. Force the mount before any other provisioning runs.
  config.vm.provision "shell", run: "always", inline: <<-SHELL
    mountpoint -q /vagrant || mount -t vboxsf vagrant /vagrant -o uid=1000,gid=1000
  SHELL

   config.vm.define "webserver" do |webserver|
   webserver.vm.hostname = "webserver"
   webserver.vm.network "forwarded_port", guest: 80, host: 8080, host_ip: "127.0.0.1"
   webserver.vm.network "private_network", ip: "192.168.2.11"

   webserver.vm.provision "shell", inline: <<-SHELL
    apt-get update
    apt-get install -y nginx

  # Change VM's webserver's configuration to use shared folder.
    # (Look inside test-website.conf for specifics.)
    cp /vagrant/test-website.conf /etc/nginx/sites-available/
    # install our website configuration and disable the default
    ln -sf /etc/nginx/sites-available/test-website.conf /etc/nginx/sites-enabled/
    rm -f /etc/nginx/sites-enabled/default
    service nginx reload
  SHELL
 end

 # dbserver must be defined (and thus provisioned) before backend: backend's
 # provisioner waits on a keypair that dbserver generates, and Vagrant brings
 # machines up in the order they're defined.
 config.vm.define "dbserver" do |dbserver|
   dbserver.vm.hostname = "dbserver"
   dbserver.vm.network "private_network", ip: "192.168.2.12"
   # Pin the SSH forwarded port explicitly: Vagrant's auto-assigned port can collide
   # with unrelated VirtualBox VMs already holding a host port (e.g. another
   # environment's default port 2222), leaving SSH silently unreachable.
   dbserver.vm.network "forwarded_port", guest: 22, host: 2210, id: "ssh", auto_correct: true

   dbserver.vm.provision "shell", inline: <<-SHELL
     apt-get update
     apt-get install -y postgresql postgresql-contrib openssh-server

     sudo -u postgres psql -tc "SELECT 1 FROM pg_database WHERE datname = 'cosc349'" | grep -q 1 || sudo -u postgres createdb cosc349

     # --- SSH tunnel key setup ---
     # Generate a keypair (once) and drop it in the shared /vagrant folder so the
     # backend VM can pick up the private half and authenticate over SSH instead
     # of a DB password.
     mkdir -p /vagrant/tunnel_keys
     if [ ! -f /vagrant/tunnel_keys/id_ed25519 ]; then
       ssh-keygen -t ed25519 -f /vagrant/tunnel_keys/id_ed25519 -N "" -q
     fi

     mkdir -p /home/vagrant/.ssh
     touch /home/vagrant/.ssh/authorized_keys
     grep -qxF "$(cat /vagrant/tunnel_keys/id_ed25519.pub)" /home/vagrant/.ssh/authorized_keys || \
       cat /vagrant/tunnel_keys/id_ed25519.pub >> /home/vagrant/.ssh/authorized_keys
     chown -R vagrant:vagrant /home/vagrant/.ssh
     chmod 700 /home/vagrant/.ssh
     chmod 600 /home/vagrant/.ssh/authorized_keys

     # No DB password at all: Postgres is only reachable via localhost (through
     # the SSH tunnel), and only someone holding the SSH private key can open
     # that tunnel, so we trust anything arriving over 127.0.0.1. Match either
     # md5 or scram-sha-256, since the default auth method varies by version.
     sed -i "s/^host\\s\\+all\\s\\+all\\s\\+127\\.0\\.0\\.1\\/32\\s\\+md5/host    all             all             127.0.0.1\\/32            trust/" /etc/postgresql/*/main/pg_hba.conf
     sed -i "s/^host\\s\\+all\\s\\+all\\s\\+127\\.0\\.0\\.1\\/32\\s\\+scram-sha-256/host    all             all             127.0.0.1\\/32            trust/" /etc/postgresql/*/main/pg_hba.conf
     service postgresql restart
     service ssh restart
    sudo -u postgres psql -d cosc349 -f /vagrant/setup-database.sql
   SHELL
 end

 config.vm.define "backend" do |backend|
   backend.vm.hostname = "backend"
   backend.vm.network "forwarded_port", guest: 8080, host: 8081, host_ip: "127.0.0.1"
   backend.vm.network "private_network", ip: "192.168.2.13"

   backend.vm.provision "shell", inline: <<-SHELL
    apt-get update
    apt-get install -y openjdk-17-jdk maven openssh-client postgresql-client
    # Build outside the VirtualBox shared folder so Maven can replace its output files.
    rm -rf /tmp/Backend
    cp -r /vagrant/Backend /tmp/Backend
    cd /tmp/Backend
    pkill -f 'assignment-tracker-0.0.1-SNAPSHOT.jar' || true

    # Wait for dbserver to have generated and shared its SSH keypair.
    until [ -f /vagrant/tunnel_keys/id_ed25519 ]; do
      sleep 2
    done
    mkdir -p /home/vagrant/.ssh
    cp /vagrant/tunnel_keys/id_ed25519 /home/vagrant/.ssh/tunnel_key
    chown vagrant:vagrant /home/vagrant/.ssh/tunnel_key
    chmod 600 /home/vagrant/.ssh/tunnel_key

    # Wait until dbserver accepts SSH with this key, then open a tunnel to its
    # Postgres port. No DB password is used: only whoever holds tunnel_key can
    # open this tunnel, and Postgres trusts connections from localhost.
    until sudo -u vagrant ssh -i /home/vagrant/.ssh/tunnel_key \
      -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
      -o ConnectTimeout=3 -o BatchMode=yes vagrant@192.168.2.12 true 2>/dev/null; do
      sleep 2
    done
    pkill -f "ssh -i /home/vagrant/.ssh/tunnel_key" || true
    sudo -u vagrant ssh -i /home/vagrant/.ssh/tunnel_key \
      -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
      -f -N -L 5432:localhost:5432 vagrant@192.168.2.12

    until pg_isready -h 127.0.0.1 -p 5432 -q; do
      sleep 2
    done

    mvn clean package -DskipTests
    JAR_FILE=$(find /tmp/Backend/target -maxdepth 1 -name "*.jar" ! -name "*sources*" | head -n 1)
    nohup java -jar "$JAR_FILE" \
      --spring.datasource.url="jdbc:postgresql://127.0.0.1:5432/cosc349" \
      --spring.datasource.username="postgres" \
      > /var/log/backend.log 2>&1 &
    sleep 15
  SHELL
 end
end
